require "shellwords"

# Fastlane 기본 설정
default_platform(:ios)

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "600"

# 앱 관련 변수
APP_NAME = "Picke"
SCHEME = "Picke"
STAGE_SCHEME = "Picke-Stage"
BUNDLE_ID = "io.Picke.co"
OUTPUT_DIR = "./fastlane/output"
IPA_FILENAME = "#{APP_NAME}.ipa"
TEAM_ID = ENV["TEAM_ID"] || "3UFKCXVTN4"
MATCH_KEYCHAIN_NAME = ENV["MATCH_KEYCHAIN_NAME"] || "match_keychain"

# 릴리스용 변수 (누락되어 있던 부분 보완)
APP_RELEASE_NAME = APP_NAME
APP_RELEASE_SCHEME = SCHEME

APP_STAGE_NAME = STAGE_SCHEME
APP_STAGE_SCHEME = STAGE_SCHEME

def unlock_match_keychain
  keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s
  if keychain_password.empty?
    UI.important("MATCH_KEYCHAIN_PASSWORD is missing. macOS may ask for the match keychain password.")
    return
  end

  keychain_path = File.expand_path("~/Library/Keychains/#{MATCH_KEYCHAIN_NAME}-db")
  unless File.exist?(keychain_path)
    # CI 등 키체인이 없는 환경에서는 새로 생성(언락 포함)
    UI.message("match keychain 생성: #{keychain_path}")
    create_keychain(
      name: MATCH_KEYCHAIN_NAME,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
    return
  end

  unlock_keychain(
    path: keychain_path,
    password: keychain_password,
    add_to_search_list: true
  )
end

def transient_upload_error?(error)
  messages = []
  current_error = error

  while current_error
    messages << current_error.message.to_s.downcase
    current_error = current_error.cause
  end

  messages.any? do |message|
    message.include?("connection reset by peer") ||
      message.include?("ssl_connect") ||
      message.include?("unexpected eof while reading") ||
      message.include?("execution expired") ||
      message.include?("timed out")
  end
end

# Sentry "Upload Mobile Builds" (Size Analysis + 사전배포) — 아카이브를 sentry-cli 로 업로드한다.
# 실패해도 배포를 절대 막지 않는다. CI 에 SENTRY_AUTH_TOKEN 시크릿과 sentry-cli 가 있을 때만 동작.
def upload_build_to_sentry(release_name: nil)
  token = ENV["SENTRY_AUTH_TOKEN"].to_s
  archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE].to_s

  if token.empty?
    UI.message("ℹ️ Sentry 빌드 업로드 스킵: SENTRY_AUTH_TOKEN 미설정")
    return
  end
  unless system("which sentry-cli >/dev/null 2>&1")
    UI.message("ℹ️ Sentry 빌드 업로드 스킵: sentry-cli 미설치 (brew install getsentry/tools/sentry-cli)")
    return
  end
  if archive.empty? || !File.directory?(archive)
    UI.message("ℹ️ Sentry 빌드 업로드 스킵: xcarchive 경로 없음")
    return
  end

  org = ENV.fetch("SENTRY_ORG", "picke")
  project = ENV.fetch("SENTRY_PROJECT", "picke-ios")
  begin
    UI.message("📦 Sentry 빌드 업로드(Size Analysis): #{archive}")
    sh("sentry-cli build upload #{Shellwords.escape(archive)} --org #{Shellwords.escape(org)} --project #{Shellwords.escape(project)}")
  rescue => e
    UI.important("⚠️ Sentry 빌드 업로드 실패(배포는 계속 진행): #{e.message}")
  end

  # dSYM 업로드 — 없으면 크래시가 심볼 없이 주소로만 남는다.
  dsym_dir = File.join(archive, "dSYMs")
  if File.directory?(dsym_dir)
    begin
      UI.message("🔣 Sentry dSYM 업로드: #{dsym_dir}")
      sh("sentry-cli debug-files upload --include-sources -o #{Shellwords.escape(org)} -p #{Shellwords.escape(project)} #{Shellwords.escape(dsym_dir)}")
    rescue => e
      UI.important("⚠️ Sentry dSYM 업로드 실패(배포는 계속 진행): #{e.message}")
    end
  else
    UI.important("⚠️ dSYMs 디렉토리 없음 — 크래시 심볼리케이션 불가: #{dsym_dir}")
  end

  # Sentry Releases 에 버전이 잡히도록 릴리즈를 생성·확정한다.
  # SDK 기본 릴리즈 형식(bundleId@version+build)과 일치해야 이벤트가 연결된다.
  if release_name && !release_name.empty?
    begin
      UI.message("🏷️ Sentry 릴리즈 생성: #{release_name}")
      sh("sentry-cli releases -o #{Shellwords.escape(org)} -p #{Shellwords.escape(project)} new #{Shellwords.escape(release_name)}")
      sh("sentry-cli releases -o #{Shellwords.escape(org)} -p #{Shellwords.escape(project)} set-commits #{Shellwords.escape(release_name)} --auto --ignore-missing")
      sh("sentry-cli releases -o #{Shellwords.escape(org)} -p #{Shellwords.escape(project)} finalize #{Shellwords.escape(release_name)}")
    rescue => e
      UI.important("⚠️ Sentry 릴리즈 생성 실패(배포는 계속 진행): #{e.message}")
    end
  end
end

def upload_to_testflight_with_retry(options)
  max_attempts = Integer(ENV.fetch("TESTFLIGHT_UPLOAD_MAX_ATTEMPTS", "3"))
  attempt = 1

  begin
    upload_to_testflight(**options)
  rescue => e
    raise unless transient_upload_error?(e) && attempt < max_attempts

    wait_seconds = 15 * attempt
    UI.important(
      "TestFlight 업로드 연결이 끊겼습니다. #{wait_seconds}초 후 재시도합니다 " \
      "(#{attempt + 1}/#{max_attempts})."
    )
    sleep(wait_seconds)
    attempt += 1
    retry
  end
end

def share_tuist_preview(ipa_path, track:)
  ipa = File.expand_path(ipa_path.to_s)
  if ipa_path.to_s.empty? || !File.file?(ipa)
    UI.important("⚠️ Tuist Preview 업로드 스킵: IPA 파일을 찾을 수 없음 (#{ipa_path})")
    return
  end

  begin
    Dir.chdir(File.expand_path("..", __dir__)) do
      sh("mise exec -- tuist share #{Shellwords.escape(ipa)} --track #{Shellwords.escape(track)}")
    end
    UI.success("✅ Tuist Preview 업로드 완료 (#{track})")
  rescue => e
    UI.important("⚠️ 앱 배포는 완료됐지만 Tuist Preview 업로드 실패: #{e.message}")
  end
end

# 릴리즈 노트를 커밋에서 자동으로 만든다.
#
# 규칙(기존에 손으로 쓰던 노트 형식을 그대로 따른다):
#   - feat/fix 커밋만 불릿으로 옮긴다. type(scope): 접두사와 끝의 (#123) 은 떼고,
#     "…한다" 종결어미는 지워 "- 댓글을 글자 수 제한 없이 작성" 같은 명사형으로 맞춘다.
#   - refactor/perf/style/chore/build 가 하나라도 있으면 마지막에
#     "- 전반적인 UI 정리 및 안정성 개선" 한 줄을 붙인다.
#   - 직전 v태그 이후 커밋만 본다. 태그가 없으면 최근 30개.
def generate_release_notes_body
  previous_tag = `git tag --sort=-v:refname --list "v*" | head -1`.strip
  range = previous_tag.empty? ? "-30" : "#{previous_tag}..HEAD"
  subjects = `git log #{range} --no-merges --pretty=%s`.split("\n").map(&:strip).reject(&:empty?)

  bullets = []
  has_chore = false

  subjects.each do |subject|
    type = subject[/\A(\w+)(\([^)]*\))?:/, 1]
    case type
    when "feat", "fix"
      text = subject.sub(/\A\w+(\([^)]*\))?:\s*/, "")
      text = text.sub(/\s*\(#\d+\)\s*\z/, "")
      text = text.sub(/한다\z/, "").sub(/\s*\z/, "")
      bullets << "- #{text}" unless text.empty?
    when "refactor", "perf", "style", "chore", "build"
      has_chore = true
    end
  end

  bullets.uniq!
  bullets << "- 전반적인 UI 정리 및 안정성 개선" if has_chore || bullets.empty?
  bullets.join("\n")
end

# 릴리즈 노트를 확정해서 돌려준다. 수동 작성분이 항상 이긴다.
#   1) ENV["RELEASE_NOTES"] 가 있으면 그대로 쓴다.
#   2) metadata/ko/release_notes.txt 가 이미 이번 버전 헤더([V x.y.z])면 손으로 쓴 것으로 보고 그대로 쓴다.
#   3) 둘 다 아니면 커밋에서 만들어 두 파일에 쓴다.
def ensure_release_notes(version)
  manual = ENV["RELEASE_NOTES"].to_s.strip
  metadata_path = File.expand_path("metadata/ko/release_notes.txt", __dir__)
  plain_path = File.expand_path("release_notes.txt", __dir__)
  header = "[V #{version}]"

  unless manual.empty?
    UI.message("📝 RELEASE_NOTES 환경변수를 그대로 사용한다")
    return manual
  end

  existing = File.exist?(metadata_path) ? File.read(metadata_path).strip : ""
  if existing.start_with?(header)
    UI.message("📝 metadata/ko/release_notes.txt 에 #{header} 노트가 이미 있어 그대로 사용한다")
    body = existing.lines.drop(1).join.strip
    ENV["RELEASE_NOTES"] = body
    return body
  end

  body = generate_release_notes_body
  File.write(plain_path, body + "\n")
  File.write(metadata_path, "#{header}\n#{body}\n")
  ENV["RELEASE_NOTES"] = body
  UI.success("📝 릴리즈 노트 자동 생성 (#{header})\n#{body}")
  body
end

def current_marketing_version
  path = File.expand_path("../Plugins/ProjectTemplatePlugin/ProjectDescriptionHelpers/Project+Templete/Extension+String.swift", __dir__)
  File.read(path)[/appVersion\(version: String = "([^"]+)"\)/, 1] || "0.0.0"
end

platform :ios do
  before_all do
    unlock_match_keychain
  end

  # 🚀 TestFlight 업로드 (Debug)
  desc "Upload to TestFlight (Debug)"
  lane :QA do

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # 빌드 번호 = 날짜형 YYMMDDHHMM (항상 증가, App Store 조회 불필요)
    new_build_number = Time.now.strftime("%y%m%d%H%M")
    puts "🔢 새로운 빌드 번호(날짜형): #{new_build_number}"

    # Extension+String.swift 의 빌드 번호 갱신 (tuist generate 시 CFBundleVersion 으로 반영)
    extension_file_path = "../Plugins/ProjectTemplatePlugin/ProjectDescriptionHelpers/Project+Templete/Extension+String.swift"
    extension_content = File.read(extension_file_path)
    extension_content = extension_content.gsub(
      /static func appBuildVersion\(buildVersion: String = "\d+"\) -> String \{/,
      "static func appBuildVersion(buildVersion: String = \"#{new_build_number}\") -> String {"
    )
    File.write(extension_file_path, extension_content)
    puts "✅ 빌드 번호를 #{new_build_number}로 업데이트 완료"

    # 갱신된 빌드 번호 반영을 위해 Tuist 강제 재생성
    Dir.chdir("..") do
      puts "🔧 Tuist workspace 재생성 중..."
      sh("tuist generate --no-binary-cache --no-open")
      puts "✅ Tuist workspace 재생성 완료"
    end

    match(
      type: "appstore",
      readonly: true,
      storage_mode: "git",
      team_id: TEAM_ID,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: ["io.Picke.co"],
      keychain_name: MATCH_KEYCHAIN_NAME,
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    ipa_path = nil
    # Change to project root directory
    Dir.chdir("..") do
      puts "📁 Current directory: #{Dir.pwd}"
      puts "📋 Available files: #{Dir.entries('.')}"

      # Try to generate workspace if missing
      workspace_files = Dir.glob("*.xcworkspace")
      if workspace_files.empty?
        puts "🔧 No workspace found, trying to generate..."

        # Check if tuist is available
        tuist_available = system("which tuist > /dev/null 2>&1")
        puts "Tuist available: #{tuist_available}"

        unless tuist_available
          puts "🔧 Installing tuist with brew..."
          sh("brew install tuist")
        end

        begin
          if File.exist?("make")
            puts "🔧 Trying Tuist install..."
            sh("mise exec -- tuist install")
            puts "🔧 Trying ./make generate..."
            sh("./make generate --no-binary-cache --no-open")
          else
            puts "🔧 Trying tuist directly..."
            sh("tuist install")
            sh("tuist generate --no-binary-cache --no-open")
          end
        rescue => e
          puts "❌ Generation failed: #{e.message}"
        end

        workspace_files = Dir.glob("*.xcworkspace")
        puts "🔍 Workspace files found: #{workspace_files}"
      end

      if workspace_files.empty?
        puts "❌ Still no workspace found!"
        puts "🔍 All files in directory:"
        Dir.entries('.').each { |f| puts "  #{f}" }
        UI.user_error!("Cannot generate workspace file. Check tuist setup and plugins.")
      end

      workspace_name = workspace_files.first
      workspace_path = File.expand_path(workspace_name)
      puts "✅ Using workspace: #{workspace_name}"
      puts "✅ Full workspace path: #{workspace_path}"

      ipa_path = build_app(
        workspace: workspace_path,
        scheme: "Picke-Stage",
        configuration: "Release",
        export_method: "app-store",
        output_directory: File.expand_path(OUTPUT_DIR),
        output_name: IPA_FILENAME,
        clean: false,
        silent: false,
        build_timing_summary: true,
        disable_package_automatic_updates: true,
        skip_package_dependencies_resolution: true,
        use_system_scm: true,
        xcargs: "CODE_SIGN_IDENTITY='Apple Distribution' CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{TEAM_ID} " +
                "COMPILER_INDEX_STORE_ENABLE=NO ENABLE_BITCODE=NO " +
                "SWIFT_COMPILATION_MODE=incremental -parallelizeTargets " +
                "ENABLE_PARALLEL_SIGNING=YES DISABLE_MANUAL_TARGET_ORDER_BUILD_WARNING=YES " +
                "FRAMEWORK_SEARCH_PATHS='$(inherited)' LIBRARY_SEARCH_PATHS='$(inherited)' " +
                "-allowProvisioningUpdates",
        export_options: {
          signingStyle: "manual",
          uploadBitcode: false,
          teamID: TEAM_ID,
          provisioningProfiles: {
            "#{BUNDLE_ID}" => "match AppStore #{BUNDLE_ID}"
          }
        }
      )
    end

    # 아카이브 산출 직후 Sentry 빌드/사이즈 업로드(비차단).
    upload_build_to_sentry

    begin
      # Picke/picke 그룹에 배포 (External 그룹이어야 실제 지정됨. Internal이면 자동 배포되고 아래 rescue로 넘어감)
      upload_to_testflight_with_retry(
        ipa: ipa_path,
        changelog: ensure_release_notes(current_marketing_version),
        groups: ["Picke", "picke"],
        beta_app_description: "Picke 앱입니다.",
        notify_external_testers: true,
        skip_waiting_for_build_processing: false,
        demo_account_required: false,
        uses_non_exempt_encryption: false
      )
    rescue => e
      # 바이너리 업로드는 끝났는데 그룹/심사 배포 단계만 실패하면 빌드 실패시키지 않고 경고만
      if e.message.include?("Another build is in review") || e.message.downcase.include?("beta review") ||
         e.message.include?("internal group") || e.message.downcase.include?("cannot be assigned")
        UI.important("⚠️ 그룹/심사 배포 단계 보류 — 바이너리 업로드는 완료됨. (Picke/picke가 Internal 그룹이면 자동 배포됨)")
      else
        raise e
      end
    end

    share_tuist_preview(ipa_path, track: "qa")
  end

  # 🚀 App Store 배포
  desc "Submit to App Store"
  lane :release do |options|
    if options[:version]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false
      )

      # 빌드 번호 = 날짜형 YYMMDDHHMM (항상 증가, App Store 조회 불필요)
      new_build_number = Time.now.strftime("%y%m%d%H%M")
      puts "🔢 새로운 빌드 번호(날짜형): #{new_build_number}"

      # Extension+String.swift 파일에서 빌드 번호 업데이트
      extension_file_path = "../Plugins/ProjectTemplatePlugin/ProjectDescriptionHelpers/Project+Templete/Extension+String.swift"
      content = File.read(extension_file_path)

      # 빌드 번호 라인 수정
      updated_content = content.gsub(/static func appBuildVersion\(buildVersion: String = "\d+"\) -> String \{/,
                                   "static func appBuildVersion(buildVersion: String = \"#{new_build_number}\") -> String {")

      File.write(extension_file_path, updated_content)
      puts "✅ 빌드 번호를 #{new_build_number}로 업데이트 완료"

      # Tuist 프로젝트 재생성
      Dir.chdir("..") do
        puts "🔧 Tuist workspace 재생성 중..."
        sh("tuist generate --no-binary-cache --no-open")
        puts "✅ Tuist workspace 재생성 완료"
      end

      match(
        type: "appstore",
        readonly: true,
        storage_mode: "git",
        team_id: TEAM_ID,
        api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
        app_identifier: ["io.Picke.co"],
        keychain_name: MATCH_KEYCHAIN_NAME,
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
      )

      ipa_path = nil
      # QA와 동일한 workspace 처리 로직
      Dir.chdir("..") do
        puts "📁 현재 디렉토리: #{Dir.pwd}"
        puts "📋 사용 가능한 파일들: #{Dir.entries('.')}"

        # Try to generate workspace if missing
        workspace_files = Dir.glob("*.xcworkspace")
        if workspace_files.empty?
          puts "🔧 workspace가 없습니다, 생성 중..."

          # Check if tuist is available
          tuist_available = system("which tuist > /dev/null 2>&1")
          puts "Tuist 사용 가능: #{tuist_available}"

          unless tuist_available
            puts "🔧 brew로 tuist 설치 중..."
            sh("brew install tuist")
          end

          begin
            if File.exist?("make")
              puts "🔧 Tuist install 실행 중..."
              sh("mise exec -- tuist install")
              puts "🔧 ./make generate 실행 중..."
              sh("./make generate --no-binary-cache --no-open")
            else
              puts "🔧 tuist 직접 실행 중..."
              sh("tuist install")
              sh("tuist generate --no-binary-cache --no-open")
            end
          rescue => e
            puts "❌ 생성 실패: #{e.message}"
          end

          workspace_files = Dir.glob("*.xcworkspace")
          puts "🔍 발견된 workspace 파일들: #{workspace_files}"
        end

        if workspace_files.empty?
          puts "❌ workspace를 찾을 수 없습니다!"
          puts "🔍 디렉토리 내 모든 파일:"
          Dir.entries('.').each { |f| puts "  #{f}" }
          UI.user_error!("workspace 파일을 생성할 수 없습니다. tuist 설정과 플러그인을 확인해주세요.")
        end

        workspace_name = workspace_files.first
        workspace_path = File.expand_path(workspace_name)
        puts "✅ 사용할 workspace: #{workspace_name}"
        puts "✅ 전체 workspace 경로: #{workspace_path}"

        ipa_path = build_app(
          workspace: workspace_path,
          scheme: "Picke-Prod",
          configuration: "Release",
          export_method: "app-store",
          output_directory: File.expand_path(OUTPUT_DIR),
          output_name: IPA_FILENAME,
          clean: false,
          silent: false,
          build_timing_summary: true,
          disable_package_automatic_updates: true,
          skip_package_dependencies_resolution: true,
          use_system_scm: true,
          xcargs: "CODE_SIGN_IDENTITY='Apple Distribution' CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{TEAM_ID} " +
                  "COMPILER_INDEX_STORE_ENABLE=NO ENABLE_BITCODE=NO " +
                  "SWIFT_COMPILATION_MODE=incremental -parallelizeTargets " +
                  "ENABLE_PARALLEL_SIGNING=YES DISABLE_MANUAL_TARGET_ORDER_BUILD_WARNING=YES " +
                  "FRAMEWORK_SEARCH_PATHS='$(inherited)' LIBRARY_SEARCH_PATHS='$(inherited)' " +
                  "-allowProvisioningUpdates",
          export_options: {
            signingStyle: "manual",
            uploadBitcode: false,
            teamID: TEAM_ID,
            provisioningProfiles: {
              "#{BUNDLE_ID}" => "match AppStore #{BUNDLE_ID}"
            }
          }
        )
      end

      # clean_symbols_from_ipa(ipa_path: ipa_path)

      # 아카이브 산출 직후 Sentry 빌드/사이즈 업로드 + 릴리즈 생성(비차단).
      upload_build_to_sentry(release_name: "io.Picke.co@#{options[:version]}+#{new_build_number}")

      # 바이너리 업로드. 이 레인은 실행할 때마다 새 빌드 번호를 만들므로(위 new_build_number)
      # 업로드를 건너뛰면 뒤이은 upload_to_app_store 가 "Build number does not exist" 로 죽는다.
      # skip_waiting_for_build_processing: false 로 App Store Connect 처리 완료까지 기다려야
      # 심사 제출 단계에서 해당 빌드를 선택할 수 있다.
      upload_to_testflight_with_retry(
        ipa: ipa_path,
        app_identifier: BUNDLE_ID,
        skip_submission: true,
        skip_waiting_for_build_processing: false,
        uses_non_exempt_encryption: false
      )

      # 심사에 올라갈 "이번 버전의 새로운 기능"을 커밋에서 채운다(수동 작성분이 있으면 그대로 둔다).
      ensure_release_notes(options[:version])

      # 심사 요청. 바이너리는 위에서 이미 올렸으므로 재업로드하지 않는다
      # (같은 빌드 번호 재업로드는 -19232 로 거부됨).
      upload_to_app_store(
        app_identifier: BUNDLE_ID,
        app_version: options[:version],
        username: ENV["APPLE_ID"],
        team_id: "KL4Y9PB9B8",
        skip_binary_upload: true,
        build_number: new_build_number,
        skip_metadata: false,
        metadata_path: "./fastlane/metadata",
        skip_screenshots: true,
        force: true,
        submit_for_review: true,
        automatic_release: false,
        precheck_include_in_app_purchases: false,
        reject_if_possible: true,
        # 광고(AdMob/AdFit) 노출로 IDFA 를 사용하므로 심사 제출 시 광고 식별자 신고를 자동 응답한다.
        # (미응답 시 "your app tracks users" 로 submit_for_review 가 거부됨)
        # 값이 실제 운영과 맞는지 확인 필요: 광고 노출=serves_ads, ATT 준수=limits_tracking.
        # 광고 기반 설치/행동 기여 트래킹을 하지 않으면 tracks_install/tracks_action 은 false.
        # (암호화 신고는 Info.plist ITSAppUsesNonExemptEncryption 로 이미 처리됨)
        submission_information: {
          add_id_info_uses_idfa: true,
          add_id_info_serves_ads: true,
          add_id_info_tracks_action: false,
          add_id_info_tracks_install: false,
          add_id_info_limits_tracking: true
        }
      )

      share_tuist_preview(ipa_path, track: "release")

      UI.success("🎉 앱 업로드 및 심사 요청 완료!")
      UI.important("")
      UI.important("📱 심사 진행 상황 확인:")
      UI.important("   1. https://appstoreconnect.apple.com 접속")
      UI.important("   2. Picke 앱 선택")
      UI.important("   3. 버전 #{options[:version]} 심사 상태 확인")
      UI.important("   4. 빌드 번호: #{new_build_number}")
      UI.important("")
      UI.success("✅ 빌드, 업로드, 심사 요청이 모두 성공적으로 완료되었습니다!")
      UI.success("🚀 이제 Apple의 심사를 기다리기만 하면 됩니다!")
    else
      UI.user_error!("⚠️ version 옵션을 지정해주세요: fastlane submit version:'1.0.0'")
    end
  end

  # 📦 Sentry Size Analysis 업로드
  desc "Archive and upload app size data to Sentry Size Analysis"
  lane :sentry_size_analysis do |options|
    sentry_org = ENV.fetch("SENTRY_ORG", "picke")
    sentry_project = ENV.fetch("SENTRY_PROJECT", "picke-ios")
    archive_path = options[:archive_path] || ENV["SENTRY_ARCHIVE_PATH"] || File.expand_path("output/#{APP_NAME}.xcarchive", __dir__)

    if ENV["SENTRY_AUTH_TOKEN"].to_s.empty?
      UI.user_error!("SENTRY_AUTH_TOKEN 이 필요합니다. Sentry Settings > Auth Tokens 에서 토큰을 발급해 주세요.")
    end

    unless system("which sentry-cli >/dev/null 2>&1")
      UI.user_error!("sentry-cli 가 필요합니다: brew install getsentry/tools/sentry-cli")
    end

    Dir.chdir("..") do
      sh("tuist generate --no-binary-cache --no-open")
      build_app(
        workspace: File.expand_path("Picke.xcworkspace"),
        scheme: SCHEME,
        configuration: "Release",
        archive_path: archive_path,
        skip_package_ipa: true,
        clean: false,
        silent: false,
        build_timing_summary: true,
        disable_package_automatic_updates: true,
        skip_package_dependencies_resolution: true,
        use_system_scm: true
      )

      sh("sentry-cli build upload #{Shellwords.escape(archive_path)} --org #{Shellwords.escape(sentry_org)} --project #{Shellwords.escape(sentry_project)}")
    end
  end

  # 🚀 이미 업로드된 버전을 심사에 제출
  desc "Submit already uploaded version for review"
  lane :submit_for_review do |options|
    if options[:version]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false
      )

      begin
        upload_to_app_store(
          app_identifier: BUNDLE_ID,
          app_version: options[:version],
          username: ENV["APPLE_ID"],
          team_id: "KL4Y9PB9B8",
          skip_binary_upload: true,
          skip_metadata: false,
          metadata_path: "./fastlane/metadata",
          skip_screenshots: true,
          force: true,
          submit_for_review: true,
          automatic_release: false,
          precheck_include_in_app_purchases: false,
          reject_if_possible: true,
          # 광고(AdMob/AdFit) IDFA 사용 신고 — release 레인과 동일 응답.
          submission_information: {
            add_id_info_uses_idfa: true,
            add_id_info_serves_ads: true,
            add_id_info_tracks_install: false,
            add_id_info_tracks_action: false,
            add_id_info_limits_tracking: true
          }
        )
        UI.success("🎉 심사 제출 완료!")
      rescue => ex
        UI.error("❌ 제출 실패: #{ex.message}")
        UI.important("")
        UI.important("🔍 App Store Connect에서 확인해야 할 사항:")
        UI.important("   1. 현재 버전의 상태 (심사 중/대기 중인지)")
        UI.important("   2. 필수 메타데이터 완성 여부")
        UI.important("   3. 스크린샷 업로드 완료 여부")
        UI.important("   4. 이전 버전 정리 완료 여부")
        UI.important("")
        UI.important("📱 App Store Connect 링크: https://appstoreconnect.apple.com")
      end
    else
      UI.user_error!("⚠️ version 옵션을 지정해주세요: fastlane submit_for_review version:'1.0.0'")
    end
  end
end
